<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 按键震动直接调振动器（见 keyboard/Haptics.kt） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 悬浮扫码窗：显示在其他应用上方且不获取输入焦点 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 悬浮扫码使用前台相机服务，避免应用退到后台后相机被系统回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 只有快捷翻译、青简翻译、补充译词与云联想（后两样缺省关）连用户自己填的大模型接口（见 cloud/ 与 Rust 侧 apps/android/core/src/cloud），语音输入连用户自己填的识别服务（见 voice/ 与 crates/qingjian-voice）；不开云联想时打字不联网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 云联想「只在 Wi-Fi 下使用」要看当前网络（见 cloud/Network.kt） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />

    <!-- 语音输入录音（见 voice/EngineRecognizer.kt）；用到时由 voice/MicrophonePermissionActivity.kt 弹框申请 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 实时地点与天气候选；用户输入相关关键词并点击授权提示后才申请 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 通讯录里的名字进候选（缺省关，见 contacts/ContactsSync.kt）；在「设置 → 词库」打开时才申请，只在本机用 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- 试打框等自家输入框的文字选择菜单要列出「青简翻译」这类文字处理项：Android 11 起不声明就查不到 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- 游戏键盘设置页列出横屏打过字的应用，要取它们的名字和图标；只查得到桌面上有图标的应用 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".QingjianApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_brand"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Qingjian">

        <activity
            android:name=".settings.home.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".background.DynamicBackgroundActivity" android:exported="false" />
        <activity android:name=".mascot.MascotPermissionActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" android:theme="@style/Theme.Qingjian.Transparent" />
        <service
            android:name=".mascot.SpriteTranslateService"
            android:label="青简悬浮小精灵智能辅助（翻译与复制）"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/sprite_service" />
        </service>
        <activity android:name=".mascot.MascotAssistActivity" android:exported="false" />
        <service android:name=".mascot.FloatingMascotService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-visible floating companion overlay" />
        </service>
        <activity android:name=".service.SmartActionActivity" android:exported="false" android:theme="@style/Theme.Qingjian.Sheet" />
        <activity android:name=".scan.BarcodeScannerActivity" android:exported="false" />
        <activity android:name=".scan.WifiJoinActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" android:theme="@style/Theme.Qingjian.Transparent" />
        <service
            android:name=".scan.ScanOverlayService"
            android:exported="false"
            android:foregroundServiceType="camera" />
        <activity
            android:name=".sms.SmsCodeSettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Qingjian.Transparent" />

        <receiver
            android:name=".sms.SmsCodeReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="500">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <activity android:name=".settings.page.InputSettingsActivity" android:exported="false" />
        <activity android:name=".settings.page.KeyboardSettingsActivity" android:exported="false" />
        <activity android:name=".settings.page.ClipboardSettingsActivity" android:exported="false" />
        <activity android:name=".settings.page.CloudSettingsActivity" android:exported="false" />
        <activity android:name=".settings.page.LocalAiSettingsActivity" android:exported="false" />
        <activity android:name=".settings.page.AppearanceActivity" android:exported="false" />
        <activity android:name=".settings.page.AboutActivity" android:exported="false" />
        <activity android:name=".settings.page.StatsActivity" android:exported="false" />
        <activity android:name=".settings.page.DictionariesActivity" android:exported="false" />
        <activity android:name=".settings.page.TrigramModelActivity" android:exported="false" />
        <activity android:name=".settings.page.AdvancedActivity" android:exported="false" />
        <activity android:name=".settings.page.VoiceSettingsActivity" android:exported="false" />
        <activity android:name=".settings.page.ScanSettingsActivity" android:exported="false" />
        <activity android:name=".settings.page.PermissionSettingsActivity" android:exported="false" />
        <activity android:name=".settings.page.ClipboardSyncActivity" android:exported="false" />
        <activity android:name=".settings.page.GameKeyboardActivity" android:exported="false" />

        <!-- 系统文字选择菜单里的「青简翻译」，见 translate/ProcessTextActivity.kt -->
        <activity
            android:name=".translate.ProcessTextActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/process_text_label"
            android:theme="@style/Theme.Qingjian.Sheet">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 输入法服务弹不了权限框，语音要录音时由它代为申请，见 voice/MicrophonePermissionActivity.kt；不进最近任务，也不带出 App 的任务栈 -->
        <activity
            android:name=".service.LocationPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Qingjian.Transparent" />

        <activity
            android:name=".voice.MicrophonePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Qingjian.Transparent" />

        <!-- 剪贴板图片交给别的应用读（发图片、放回系统剪贴板），见 clipboard/ClipboardImageProvider.kt -->
        <provider
            android:name=".clipboard.ClipboardImageProvider"
            android:authorities="${applicationId}.clipboard"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 打包好的日志交给 QQ、微信等应用发送，见 settings/page/LogShareProvider.kt -->
        <provider
            android:name=".settings.page.LogShareProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".service.QingjianInputMethodService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
